{"ast":null,"code":"export default {\n  name: 'EditarPelicula',\n  props: {\n    show: Boolean,\n    pelicula: Object\n  },\n  data() {\n    return {\n      localPelicula: null\n    };\n  },\n  watch: {\n    pelicula: {\n      handler(newVal) {\n        if (newVal) {\n          this.localPelicula = {\n            ...newVal\n          };\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    guardar() {\n      // Emitimos los datos editados al padre\n      this.$emit('guardar', {\n        ...this.localPelicula\n      });\n      // Cerramos automáticamente el modal\n      this.$emit('close');\n    }\n  }\n};","map":{"version":3,"names":["name","props","show","Boolean","pelicula","Object","data","localPelicula","watch","handler","newVal","immediate","methods","guardar","$emit"],"sources":["C:\\Users\\Ruben\\carpeta trabajo\\python\\FastAPI\\PrimerosPasosFastAPI\\frontend\\src\\components\\EditarPelicula.vue"],"sourcesContent":["<template>\n  <div v-if=\"show\" class=\"modal-overlay\">\n    <div class=\"modal-content\">\n      <!-- X para cerrar manualmente -->\n      <button class=\"close-btn\" @click=\"$emit('close')\">X</button>\n\n      <form @submit.prevent=\"guardar\" v-if=\"localPelicula\">\n        <h3>\n          Editar película: {{ localPelicula.titulo }}\n        </h3>\n\n        <label>Título</label>\n        <input type=\"text\" v-model=\"localPelicula.titulo\" /><br><br>\n\n        <label>Género</label>\n        <input type=\"text\" v-model=\"localPelicula.genero\" /><br><br>\n\n        <label>Año</label>\n        <input type=\"number\" v-model=\"localPelicula.ano\" /><br><br>\n\n        <input type=\"submit\" value=\"Guardar\">\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'EditarPelicula',\n  props: {\n    show: Boolean,\n    pelicula: Object\n  },\n  data() {\n    return {\n      localPelicula: null\n    }\n  },\n  watch: {\n    pelicula: {\n      handler(newVal) {\n        if (newVal) {\n          this.localPelicula = { ...newVal }\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    guardar() {\n      // Emitimos los datos editados al padre\n      this.$emit('guardar', { ...this.localPelicula })\n      // Cerramos automáticamente el modal\n      this.$emit('close')\n    }\n  }\n}\n</script>\n\n<style>\n.modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: rgba(0,0,0,0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  position: relative; /* Para que la X se posicione correctamente */\n  background-color: rgb(223, 221, 221);\n  padding: 20px;\n  border-radius: 8px;\n  width: 400px;\n  max-width: 90%;\n  color: black;\n}\n\n.close-btn {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  border: none;\n  background: transparent;\n  font-size: 20px;\n  cursor: pointer;\n  color: black;\n}\n</style>\n"],"mappings":"AA2BA,eAAe;EACbA,IAAI,EAAE,gBAAgB;EACtBC,KAAK,EAAE;IACLC,IAAI,EAAEC,OAAO;IACbC,QAAQ,EAAEC;EACZ,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE;IACjB;EACF,CAAC;EACDC,KAAK,EAAE;IACLJ,QAAQ,EAAE;MACRK,OAAOA,CAACC,MAAM,EAAE;QACd,IAAIA,MAAM,EAAE;UACV,IAAI,CAACH,aAAY,GAAI;YAAE,GAAGG;UAAO;QACnC;MACF,CAAC;MACDC,SAAS,EAAE;IACb;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,OAAOA,CAAA,EAAG;MACR;MACA,IAAI,CAACC,KAAK,CAAC,SAAS,EAAE;QAAE,GAAG,IAAI,CAACP;MAAc,CAAC;MAC/C;MACA,IAAI,CAACO,KAAK,CAAC,OAAO;IACpB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}