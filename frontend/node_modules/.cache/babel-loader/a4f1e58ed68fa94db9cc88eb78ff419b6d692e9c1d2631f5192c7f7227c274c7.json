{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport { ref } from 'vue';\nexport default {\n  name: 'FormularioLogin',\n  emits: ['loginExitoso'],\n  // Declaramos el evento que emitiremos al padre\n  setup(props, {\n    emit\n  }) {\n    const usuario = ref('');\n    const password = ref('');\n    const login = async () => {\n      try {\n        const res = await fetch('http://127.0.0.1:8000/login', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            nombre: usuario.value,\n            password: password.value\n          })\n        });\n        console.log('Status:', res.status); // depuración\n        console.log('res.ok:', res.ok);\n        const data = await res.json();\n        console.log('Data recibida:', data); // depuración\n\n        // Emitimos solo si mensaje es correcto\n        if (res.ok) {\n          emit('loginExitoso');\n        } else {\n          alert(data.detail || 'Usuario o contraseña incorrectos');\n        }\n      } catch (err) {\n        console.error('Error al loguearse:', err);\n      }\n    };\n    return {\n      usuario,\n      password,\n      login\n    };\n  }\n};","map":{"version":3,"names":["ref","name","emits","setup","props","emit","usuario","password","login","res","fetch","method","headers","body","JSON","stringify","nombre","value","console","log","status","ok","data","json","alert","detail","err","error"],"sources":["C:\\Users\\Ruben\\carpeta trabajo\\python\\FastAPI\\PrimerosPasosFastAPI\\frontend\\src\\components\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"login-container\">\n    <h2>Inicia sesion para poder ver el listado de peliculas.</h2>\n    <form @submit.prevent=\"login\">\n      <div class=\"formulario\">\n        <label for=\"usuario\">Usuario:</label>\n        <input type=\"text\" id=\"usuario\" v-model=\"usuario\" placeholder=\"Introduce tu usuario\" required />\n      </div>\n\n      <div class=\"formulario\">\n        <label for=\"password\">Contraseña:</label>\n        <input type=\"password\" id=\"password\" v-model=\"password\" placeholder=\"Introduce tu contraseña\" required />\n      </div>\n\n      <button type=\"submit\">Entrar</button>\n    </form>\n  </div>\n</template>\n\n<script>\nimport { ref } from 'vue'\n\nexport default {\n  name: 'FormularioLogin',\n  emits: ['loginExitoso'], // Declaramos el evento que emitiremos al padre\n  setup(props, { emit }) {\n    const usuario = ref('')\n    const password = ref('')\n\n    const login = async () => {\n      try {\n        const res = await fetch('http://127.0.0.1:8000/login', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ nombre: usuario.value, password: password.value })\n        })\n\n        console.log('Status:', res.status) // depuración\n        console.log('res.ok:', res.ok)\n\n        const data = await res.json()\n        console.log('Data recibida:', data) // depuración\n\n        // Emitimos solo si mensaje es correcto\n        if (res.ok) {\n          emit('loginExitoso')\n        } else {\n          alert(data.detail || 'Usuario o contraseña incorrectos')\n        }\n\n      } catch (err) {\n        console.error('Error al loguearse:', err)\n      }\n    }\n\n\n\n    return {\n      usuario,\n      password,\n      login\n    }\n  }\n}\n</script>\n\n\n<style>\n.login-container {\n  max-width: 400px;\n  margin: 50px auto;\n  padding: 20px;\n  border-radius: 8px;\n  background-color: #f5f5f5;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n}\n\n.formulario {\n  margin-bottom: 50px;\n}\n\nlabel {\n  display: block;\n  margin-bottom: 5px;\n}\n\ninput {\n  width: 100%;\n  padding: 8px;\n  border-radius: 4px;\n  border: 1px solid #ccc;\n}\n\nbutton {\n  padding: 10px 20px;\n  border: none;\n  border-radius: 4px;\n  background-color: #50558f;\n  color: white;\n  cursor: pointer;\n}\n\nbutton:hover {\n  transform: scale(1.2);\n  transition: transform 0.3s ease;\n\n\n}\n</style>"],"mappings":";AAoBA,SAASA,GAAE,QAAS,KAAI;AAExB,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,cAAc,CAAC;EAAE;EACzBC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,OAAM,GAAIN,GAAG,CAAC,EAAE;IACtB,MAAMO,QAAO,GAAIP,GAAG,CAAC,EAAE;IAEvB,MAAMQ,KAAI,GAAI,MAAAA,CAAA,KAAY;MACxB,IAAI;QACF,MAAMC,GAAE,GAAI,MAAMC,KAAK,CAAC,6BAA6B,EAAE;UACrDC,MAAM,EAAE,MAAM;UACdC,OAAO,EAAE;YAAE,cAAc,EAAE;UAAmB,CAAC;UAC/CC,IAAI,EAAEC,IAAI,CAACC,SAAS,CAAC;YAAEC,MAAM,EAAEV,OAAO,CAACW,KAAK;YAAEV,QAAQ,EAAEA,QAAQ,CAACU;UAAM,CAAC;QAC1E,CAAC;QAEDC,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEV,GAAG,CAACW,MAAM,GAAE;QACnCF,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEV,GAAG,CAACY,EAAE;QAE7B,MAAMC,IAAG,GAAI,MAAMb,GAAG,CAACc,IAAI,CAAC;QAC5BL,OAAO,CAACC,GAAG,CAAC,gBAAgB,EAAEG,IAAI,GAAE;;QAEpC;QACA,IAAIb,GAAG,CAACY,EAAE,EAAE;UACVhB,IAAI,CAAC,cAAc;QACrB,OAAO;UACLmB,KAAK,CAACF,IAAI,CAACG,MAAK,IAAK,kCAAkC;QACzD;MAEF,EAAE,OAAOC,GAAG,EAAE;QACZR,OAAO,CAACS,KAAK,CAAC,qBAAqB,EAAED,GAAG;MAC1C;IACF;IAIA,OAAO;MACLpB,OAAO;MACPC,QAAQ;MACRC;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}