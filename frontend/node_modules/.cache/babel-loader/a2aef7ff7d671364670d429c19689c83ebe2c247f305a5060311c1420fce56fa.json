{"ast":null,"code":"export default {\n  name: 'CrearPelicula',\n  props: {\n    show: Boolean\n  },\n  data() {\n    return {\n      nuevaPelicula: {\n        titulo: '',\n        genero: '',\n        ano: ''\n      }\n    };\n  },\n  methods: {\n    crear() {\n      this.$emit('crear', {\n        ...this.nuevaPelicula\n      });\n      this.nuevaPelicula = {\n        titulo: '',\n        genero: '',\n        ano: ''\n      };\n      this.$emit('close');\n    }\n  }\n};","map":{"version":3,"names":["name","props","show","Boolean","data","nuevaPelicula","titulo","genero","ano","methods","crear","$emit"],"sources":["C:\\Users\\Ruben\\carpeta trabajo\\python\\FastAPI\\PrimerosPasosFastAPI\\frontend\\src\\components\\CrearPelicula.vue"],"sourcesContent":["<template>\n  <div v-if=\"show\" class=\"modal-overlay\">\n    <div class=\"modal-content\">\n      <button class=\"close-btn\" @click=\"$emit('close')\">X</button>\n\n      <form @submit.prevent=\"crear\">\n        <h3>Crear nueva película</h3>\n\n        <label>Título</label>\n        <input type=\"text\" v-model=\"nuevaPelicula.titulo\" placeholder=\"Título\" required /><br><br>\n\n        <label>Género</label>\n        <input type=\"text\" v-model=\"nuevaPelicula.genero\" placeholder=\"Género\" required /><br><br>\n\n        <label>Año</label>\n        <input type=\"number\" v-model=\"nuevaPelicula.ano\" placeholder=\"Año\" required /><br><br>\n\n        <input type=\"submit\" value=\"Crear\">\n      </form>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'CrearPelicula',\n  props: { show: Boolean },\n  data() {\n    return {\n      nuevaPelicula: {\n        titulo: '',\n        genero: '',\n        ano: ''\n      }\n    }\n  },\n  methods: {\n    crear() {\n      this.$emit('crear', { ...this.nuevaPelicula })\n      this.nuevaPelicula = { titulo: '', genero: '', ano: '' }\n      this.$emit('close')\n    }\n  }\n}\n</script>\n\n<style>\n.modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: rgba(0,0,0,0.5);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  position: relative; /* Para que la X se posicione correctamente */\n  background-color: rgb(223, 221, 221);\n  padding: 20px;\n  border-radius: 8px;\n  width: 400px;\n  max-width: 90%;\n  color: black;\n}\n\n.close-btn {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  border: none;\n  background: transparent;\n  font-size: 20px;\n  cursor: pointer;\n  color: black;\n}\n</style>\n"],"mappings":"AAwBA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IAAEC,IAAI,EAAEC;EAAQ,CAAC;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE;QACbC,MAAM,EAAE,EAAE;QACVC,MAAM,EAAE,EAAE;QACVC,GAAG,EAAE;MACP;IACF;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,KAAKA,CAAA,EAAG;MACN,IAAI,CAACC,KAAK,CAAC,OAAO,EAAE;QAAE,GAAG,IAAI,CAACN;MAAc,CAAC;MAC7C,IAAI,CAACA,aAAY,GAAI;QAAEC,MAAM,EAAE,EAAE;QAAEC,MAAM,EAAE,EAAE;QAAEC,GAAG,EAAE;MAAG;MACvD,IAAI,CAACG,KAAK,CAAC,OAAO;IACpB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}