{"ast":null,"code":"export default {\n  name: 'EditarPelicula',\n  props: {\n    show: Boolean,\n    pelicula: Object\n  },\n  data() {\n    return {\n      localPelicula: null\n    };\n  },\n  watch: {\n    pelicula: {\n      handler(newVal) {\n        if (newVal) {\n          this.localPelicula = {\n            ...newVal\n          };\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    guardar() {\n      // Emitimos los datos editados al padre\n      this.$emit('guardar', {\n        ...this.localPelicula\n      });\n      // Cerramos automáticamente el modal\n      this.$emit('close');\n    }\n  }\n};","map":{"version":3,"names":["name","props","show","Boolean","pelicula","Object","data","localPelicula","watch","handler","newVal","immediate","methods","guardar","$emit"],"sources":["C:\\Users\\Ruben\\carpeta trabajo\\python\\FastAPI\\PrimerosPasosFastAPI\\frontend\\src\\components\\EditarPelicula.vue"],"sourcesContent":["<template>\n  <transition name=\"modal-fade\">\n    <div v-if=\"show\" class=\"modal-overlay\">\n      <div class=\"modal-content transform transition-all duration-300 animate-slide-in\" v-if=\"localPelicula\">\n        <!-- Header con Close Button -->\n        <div class=\"flex items-center justify-between mb-6\">\n          <h2 class=\"text-2xl font-bold text-gradient line-clamp-1\">\n            ✏️ Editar: {{ localPelicula.titulo }}\n          </h2>\n          <button\n            @click=\"$emit('close')\"\n            class=\"text-3xl text-gray-400 hover:text-gray-600 transition-colors transform hover:scale-110 flex-shrink-0\"\n          >\n            ✕\n          </button>\n        </div>\n\n        <!-- Información del ID -->\n        <div class=\"bg-primary-50 rounded-lg p-3 mb-6 text-center\">\n          <p class=\"text-xs text-gray-600 font-semibold\">ID de la Película</p>\n          <p class=\"text-lg font-bold text-primary-600\">#{{ localPelicula.idPelicula }}</p>\n        </div>\n\n        <!-- Formulario -->\n        <form @submit.prevent=\"guardar\" class=\"space-y-5\">\n          <!-- Campo Título -->\n          <div class=\"space-y-2\">\n            <label for=\"titulo\" class=\"font-semibold text-gray-700\">\n              🎬 Título\n            </label>\n            <input\n              id=\"titulo\"\n              type=\"text\"\n              v-model=\"localPelicula.titulo\"\n              placeholder=\"Edita el título\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Campo Género -->\n          <div class=\"space-y-2\">\n            <label for=\"genero\" class=\"font-semibold text-gray-700\">\n              🎭 Género\n            </label>\n            <input\n              id=\"genero\"\n              type=\"text\"\n              v-model=\"localPelicula.genero\"\n              placeholder=\"Edita el género\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Campo Año -->\n          <div class=\"space-y-2\">\n            <label for=\"ano\" class=\"font-semibold text-gray-700\">\n              📅 Año\n            </label>\n            <input\n              id=\"ano\"\n              type=\"number\"\n              v-model=\"localPelicula.ano\"\n              placeholder=\"Edita el año\"\n              min=\"1900\"\n              :max=\"new Date().getFullYear()\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Botones -->\n          <div class=\"flex gap-3 pt-6 border-t border-gray-200\">\n            <button\n              type=\"button\"\n              @click=\"$emit('close')\"\n              class=\"btn-ghost flex-1 py-3\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              class=\"btn-primary flex-1 py-3 font-bold\"\n            >\n              Guardar Cambios\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </transition>\n</template>\n\n<script>\nexport default {\n  name: 'EditarPelicula',\n  props: {\n    show: Boolean,\n    pelicula: Object\n  },\n  data() {\n    return {\n      localPelicula: null\n    }\n  },\n  watch: {\n    pelicula: {\n      handler(newVal) {\n        if (newVal) {\n          this.localPelicula = { ...newVal }\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    guardar() {\n      // Emitimos los datos editados al padre\n      this.$emit('guardar', { ...this.localPelicula })\n      // Cerramos automáticamente el modal\n      this.$emit('close')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.modal-fade-enter-active,\n.modal-fade-leave-active {\n  transition: opacity 0.3s ease;\n}\n\n.modal-fade-enter-from,\n.modal-fade-leave-to {\n  opacity: 0;\n}\n\n.modal-fade-enter-to,\n.modal-fade-leave-from {\n  opacity: 1;\n}\n</style>\n\n"],"mappings":"AA+FA,eAAe;EACbA,IAAI,EAAE,gBAAgB;EACtBC,KAAK,EAAE;IACLC,IAAI,EAAEC,OAAO;IACbC,QAAQ,EAAEC;EACZ,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE;IACjB;EACF,CAAC;EACDC,KAAK,EAAE;IACLJ,QAAQ,EAAE;MACRK,OAAOA,CAACC,MAAM,EAAE;QACd,IAAIA,MAAM,EAAE;UACV,IAAI,CAACH,aAAY,GAAI;YAAE,GAAGG;UAAO;QACnC;MACF,CAAC;MACDC,SAAS,EAAE;IACb;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,OAAOA,CAAA,EAAG;MACR;MACA,IAAI,CAACC,KAAK,CAAC,SAAS,EAAE;QAAE,GAAG,IAAI,CAACP;MAAc,CAAC;MAC/C;MACA,IAAI,CAACO,KAAK,CAAC,OAAO;IACpB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}