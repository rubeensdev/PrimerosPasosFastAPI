{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport { ref } from 'vue';\nexport default {\n  name: 'FormularioLogin',\n  emits: ['loginExitoso'],\n  // Declaramos el evento que emitiremos al padre\n  setup(props, {\n    emit\n  }) {\n    const usuario = ref('');\n    const password = ref('');\n    const login = async () => {\n      try {\n        const res = await fetch('http://127.0.0.1:8000/login', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            nombre: usuario.value,\n            password: password.value\n          })\n        });\n        console.log('Status:', res.status); // depuración\n        console.log('res.ok:', res.ok);\n        const data = await res.json();\n        console.log('Data recibida:', data); // depuración\n\n        // Emitimos solo si mensaje es correcto\n        if (res.ok) {\n          emit('loginExitoso');\n        } else {\n          alert(data.detail || 'Usuario o contraseña incorrectos');\n        }\n      } catch (err) {\n        console.error('Error al loguearse:', err);\n      }\n    };\n    return {\n      usuario,\n      password,\n      login\n    };\n  }\n};","map":{"version":3,"names":["ref","name","emits","setup","props","emit","usuario","password","login","res","fetch","method","headers","body","JSON","stringify","nombre","value","console","log","status","ok","data","json","alert","detail","err","error"],"sources":["C:\\Users\\Ruben\\carpeta trabajo\\python\\FastAPI\\PrimerosPasosFastAPI\\frontend\\src\\components\\Login.vue"],"sourcesContent":["<template>\n  <div class=\"min-h-screen flex-center bg-gradient-to-br from-primary-50 via-white to-secondary-50\">\n    <!-- Card Principal -->\n    <div class=\"card w-full max-w-md mx-4 transform animate-fade-in\">\n      <div class=\"card-header text-center\">\n        <h1 class=\"text-3xl font-bold text-primary-100\"> CineDB</h1>\n        <p class=\"text-primary-100 mt-2\">Acceso a tu biblioteca de películas</p>\n      </div>\n\n      <!-- Body del Formulario -->\n      <div class=\"card-body\">\n        <form @submit.prevent=\"login\" class=\"space-y-6\">\n          <!-- Campo Usuario -->\n          <div class=\"space-y-2\">\n            <label for=\"usuario\" class=\"flex items-center gap-2\">\n              <span>Usuario</span>\n            </label>\n            <input\n              type=\"text\"\n              id=\"usuario\"\n              v-model=\"usuario\"\n              placeholder=\"Escribe tu usuario\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Campo Contraseña -->\n          <div class=\"space-y-2\">\n            <label for=\"password\" class=\"flex items-center gap-2\">\n              <span>Contraseña</span>\n            </label>\n            <input\n              type=\"password\"\n              id=\"password\"\n              v-model=\"password\"\n              placeholder=\"Escribe tu contraseña\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Botón Entrar -->\n          <button\n            type=\"submit\"\n            class=\"btn-primary w-full font-bold text-lg py-4 flex items-center justify-center gap-2 group\"\n          >\n            <span>Entrar</span>\n          </button>\n\n          <!-- Información -->\n          <p class=\"text-center text-sm text-gray-600 pt-4 border-t border-gray-200\">\n            Usuario demo: <span class=\"font-semibold text-primary-600\">admin</span>\n          </p>\n        </form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ref } from 'vue'\n\nexport default {\n  name: 'FormularioLogin',\n  emits: ['loginExitoso'], // Declaramos el evento que emitiremos al padre\n  setup(props, { emit }) {\n    const usuario = ref('')\n    const password = ref('')\n\n    const login = async () => {\n      try {\n        const res = await fetch('http://127.0.0.1:8000/login', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ nombre: usuario.value, password: password.value })\n        })\n\n        console.log('Status:', res.status) // depuración\n        console.log('res.ok:', res.ok)\n\n        const data = await res.json()\n        console.log('Data recibida:', data) // depuración\n\n        // Emitimos solo si mensaje es correcto\n        if (res.ok) {\n          emit('loginExitoso')\n        } else {\n          alert(data.detail || 'Usuario o contraseña incorrectos')\n        }\n\n      } catch (err) {\n        console.error('Error al loguearse:', err)\n      }\n    }\n\n\n\n    return {\n      usuario,\n      password,\n      login\n    }\n  }\n}\n</script>\n\n\n<style scoped>\n/* Las clases principales están en tailwind.css */\n</style>"],"mappings":";AA6DA,SAASA,GAAE,QAAS,KAAI;AAExB,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE,CAAC,cAAc,CAAC;EAAE;EACzBC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IACrB,MAAMC,OAAM,GAAIN,GAAG,CAAC,EAAE;IACtB,MAAMO,QAAO,GAAIP,GAAG,CAAC,EAAE;IAEvB,MAAMQ,KAAI,GAAI,MAAAA,CAAA,KAAY;MACxB,IAAI;QACF,MAAMC,GAAE,GAAI,MAAMC,KAAK,CAAC,6BAA6B,EAAE;UACrDC,MAAM,EAAE,MAAM;UACdC,OAAO,EAAE;YAAE,cAAc,EAAE;UAAmB,CAAC;UAC/CC,IAAI,EAAEC,IAAI,CAACC,SAAS,CAAC;YAAEC,MAAM,EAAEV,OAAO,CAACW,KAAK;YAAEV,QAAQ,EAAEA,QAAQ,CAACU;UAAM,CAAC;QAC1E,CAAC;QAEDC,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEV,GAAG,CAACW,MAAM,GAAE;QACnCF,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEV,GAAG,CAACY,EAAE;QAE7B,MAAMC,IAAG,GAAI,MAAMb,GAAG,CAACc,IAAI,CAAC;QAC5BL,OAAO,CAACC,GAAG,CAAC,gBAAgB,EAAEG,IAAI,GAAE;;QAEpC;QACA,IAAIb,GAAG,CAACY,EAAE,EAAE;UACVhB,IAAI,CAAC,cAAc;QACrB,OAAO;UACLmB,KAAK,CAACF,IAAI,CAACG,MAAK,IAAK,kCAAkC;QACzD;MAEF,EAAE,OAAOC,GAAG,EAAE;QACZR,OAAO,CAACS,KAAK,CAAC,qBAAqB,EAAED,GAAG;MAC1C;IACF;IAIA,OAAO;MACLpB,OAAO;MACPC,QAAQ;MACRC;IACF;EACF;AACF","ignoreLis