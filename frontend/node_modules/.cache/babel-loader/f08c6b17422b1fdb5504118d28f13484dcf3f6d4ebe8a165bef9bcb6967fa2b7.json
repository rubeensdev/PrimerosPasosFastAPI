{"ast":null,"code":"export default {\n  name: 'CrearPelicula',\n  props: {\n    show: Boolean\n  },\n  data() {\n    return {\n      nuevaPelicula: {\n        titulo: '',\n        genero: '',\n        ano: ''\n      }\n    };\n  },\n  methods: {\n    crear() {\n      this.$emit('crear', {\n        ...this.nuevaPelicula\n      });\n      this.nuevaPelicula = {\n        titulo: '',\n        genero: '',\n        ano: ''\n      };\n      this.$emit('close');\n    }\n  }\n};","map":{"version":3,"names":["name","props","show","Boolean","data","nuevaPelicula","titulo","genero","ano","methods","crear","$emit"],"sources":["C:\\Users\\Ruben\\carpeta trabajo\\python\\FastAPI\\PrimerosPasosFastAPI\\frontend\\src\\components\\CrearPelicula.vue"],"sourcesContent":["<template>\n  <transition name=\"modal-fade\">\n    <div v-if=\"show\" class=\"modal-overlay\">\n      <div class=\"modal-content transform transition-all duration-300 animate-slide-in\">\n        <!-- Header con Close Button -->\n        <div class=\"flex items-center justify-between mb-6\">\n          <h2 class=\"text-2xl font-bold text-gradient\">➕ Crear Nueva Película</h2>\n          <button\n            @click=\"$emit('close')\"\n            class=\"text-3xl text-gray-400 hover:text-gray-600 transition-colors transform hover:scale-110\"\n          >\n            ✕\n          </button>\n        </div>\n\n        <!-- Formulario -->\n        <form @submit.prevent=\"crear\" class=\"space-y-5\">\n          <!-- Campo Título -->\n          <div class=\"space-y-2\">\n            <label for=\"titulo\" class=\"font-semibold text-gray-700\">\n              🎬 Título\n            </label>\n            <input\n              id=\"titulo\"\n              type=\"text\"\n              v-model=\"nuevaPelicula.titulo\"\n              placeholder=\"Ej: Inception\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Campo Género -->\n          <div class=\"space-y-2\">\n            <label for=\"genero\" class=\"font-semibold text-gray-700\">\n              🎭 Género\n            </label>\n            <input\n              id=\"genero\"\n              type=\"text\"\n              v-model=\"nuevaPelicula.genero\"\n              placeholder=\"Ej: Ciencia Ficción\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Campo Año -->\n          <div class=\"space-y-2\">\n            <label for=\"ano\" class=\"font-semibold text-gray-700\">\n              📅 Año\n            </label>\n            <input\n              id=\"ano\"\n              type=\"number\"\n              v-model=\"nuevaPelicula.ano\"\n              placeholder=\"Ej: 2010\"\n              min=\"1900\"\n              :max=\"new Date().getFullYear()\"\n              required\n              class=\"input-field focus:ring-4 focus:ring-primary-200\"\n            />\n          </div>\n\n          <!-- Botones -->\n          <div class=\"flex gap-3 pt-6 border-t border-gray-200\">\n            <button\n              type=\"button\"\n              @click=\"$emit('close')\"\n              class=\"btn-ghost flex-1 py-3\"\n            >\n              Cancelar\n            </button>\n            <button\n              type=\"submit\"\n              class=\"btn-primary flex-1 py-3 font-bold\"\n            >\n              Crear Película\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </transition>\n</template>\n\n<script>\nexport default {\n  name: 'CrearPelicula',\n  props: { show: Boolean },\n  data() {\n    return {\n      nuevaPelicula: {\n        titulo: '',\n        genero: '',\n        ano: ''\n      }\n    }\n  },\n  methods: {\n    crear() {\n      this.$emit('crear', { ...this.nuevaPelicula })\n      this.nuevaPelicula = { titulo: '', genero: '', ano: '' }\n      this.$emit('close')\n    }\n  }\n}\n</script>\n