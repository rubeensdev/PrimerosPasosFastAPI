{"ast":null,"code":"import { ref } from 'vue';\nimport FormularioLogin from './components/Login.vue';\nimport TablaPeliculas from './components/TablaPelicula.vue';\nexport default {\n  name: 'App',\n  components: {\n    FormularioLogin,\n    TablaPeliculas\n  },\n  setup() {\n    const mostrarFormulario = ref(true);\n    const mostrarPeliculas = ref(false);\n    const componentKey = ref(0);\n    const onLoginExitoso = () => {\n      console.log('Login exitoso, mostrando películas...');\n      mostrarFormulario.value = false;\n      mostrarPeliculas.value = true;\n      componentKey.value++; // Forzar re-montaje\n    };\n    return {\n      mostrarFormulario,\n      mostrarPeliculas,\n      onLoginExitoso,\n      componentKey\n    };\n  }\n};","map":{"version":3,"names":["ref","FormularioLogin","TablaPeliculas","name","components","setup","mostrarFormulario","mostrarPeliculas","componentKey","onLoginExitoso","console","log","value"],"sources":["C:\\Users\\Ruben\\carpeta trabajo\\python\\FastAPI\\PrimerosPasosFastAPI\\frontend\\src\\App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <FormularioLogin v-if=\"mostrarFormulario\" @loginExitoso=\"onLoginExitoso\" />\n    <!-- Usar :key para forzar re-montaje del componente -->\n    <TablaPeliculas v-else-if=\"mostrarPeliculas\" :key=\"componentKey\" />\n  </div>\n</template>\n\n<script>\nimport { ref } from 'vue'\nimport FormularioLogin from './components/Login.vue'\nimport TablaPeliculas from './components/TablaPelicula.vue'\n\nexport default {\n  name: 'App',\n  components: { FormularioLogin, TablaPeliculas },\n  setup() {\n    const mostrarFormulario = ref(true)\n    const mostrarPeliculas = ref(false)\n    const componentKey = ref(0)\n\n    const onLoginExitoso = () => {\n      console.log('Login exitoso, mostrando películas...')\n      mostrarFormulario.value = false\n      mostrarPeliculas.value = true\n      componentKey.value++ // Forzar re-montaje\n    }\n\n    return { mostrarFormulario, mostrarPeliculas, onLoginExitoso, componentKey }\n  }\n}\n</script>\n\n<style>\n#app {\n  font-family: Avenir, Helvetica, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  text-align: center;\n  color: #2c3e50;\n  margin-top: 60px;\n}\n</style>"],"mappings":"AASA,SAASA,GAAE,QAAS,KAAI;AACxB,OAAOC,eAAc,MAAO,wBAAuB;AACnD,OAAOC,cAAa,MAAO,gCAA+B;AAE1D,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IAAEH,eAAe;IAAEC;EAAe,CAAC;EAC/CG,KAAKA,CAAA,EAAG;IACN,MAAMC,iBAAgB,GAAIN,GAAG,CAAC,IAAI;IAClC,MAAMO,gBAAe,GAAIP,GAAG,CAAC,KAAK;IAClC,MAAMQ,YAAW,GAAIR,GAAG,CAAC,CAAC;IAE1B,MAAMS,cAAa,GAAIA,CAAA,KAAM;MAC3BC,OAAO,CAACC,GAAG,CAAC,uCAAuC;MACnDL,iBAAiB,CAACM,KAAI,GAAI,KAAI;MAC9BL,gBAAgB,CAACK,KAAI,GAAI,IAAG;MAC5BJ,YAAY,CAACI,KAAK,EAAC,EAAE;IACvB;IAEA,OAAO;MAAEN,iBAAiB;MAAEC,gBAAgB;MAAEE,cAAc;MAAED;IAAa;EAC7E;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}